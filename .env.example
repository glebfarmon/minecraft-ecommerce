# apps/api — Postgres from `docker compose up -d postgres`
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
# apps/web — where the server fetches the API from
API_ORIGIN=http://localhost:4000
# apps/api — Redis from `docker compose up -d redis`
REDIS_URL=redis://localhost:6379
# apps/api — Better Auth: public admin origin (cookies, OAuth callbacks) and a 32+ char secret
BETTER_AUTH_URL=http://admin.shop.localhost
BETTER_AUTH_SECRET=
# apps/api — mail: SMTP_URL sends through SMTP (Mailpit: `docker compose up -d mailpit`, then
# smtp://localhost:1025, inbox at http://localhost:8025); RESEND_API_KEY (production) wins over SMTP_URL;
# neither set logs mail to the console.
RESEND_API_KEY=
# MAIL_FROM defaults to Shop <no-reply@shop.localhost>.
SMTP_URL=
MAIL_FROM=
# apps/api seed — the first owner: the seed invites this email (once) and prints the link
ADMIN_OWNER_EMAIL=
# apps/api — optional sign-in providers; a provider is enabled only when both values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# apps/admin — `on` shows "Continue with Google" on the sign-in pages (set it when the API has Google keys)
GOOGLE_SIGN_IN=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# apps/api — optional rate-limit overrides (positive integers; empty = spec default). Sign-in codes per
# email per 10 min (3) and per IP per hour (10); TOTP/backup-code checks per session per minute (5)
# and per user per day (30); admin API per session per minute (300) and per IP per minute (600); everything else per IP per
# minute (100).
RATE_LIMIT_OTP_EMAIL=
RATE_LIMIT_OTP_IP=
RATE_LIMIT_SECOND_FACTOR=
RATE_LIMIT_2FA_DAY=
RATE_LIMIT_ADMIN=
RATE_LIMIT_ADMIN_IP=
RATE_LIMIT_DEFAULT=
# apps/api — RCON passwords are stored AES-256-GCM encrypted with this key (32 bytes, base64):
# `openssl rand -base64 32`. Without it, RCON settings and tests answer 503; the shop keeps working.
# Changing it makes stored RCON passwords unreadable (enter them again).
RCON_ENCRYPTION_KEY=
# apps/api — `true` lets RCON point at localhost / private networks. Dev and tests only, never in
# production: it would let an admin probe the server's internal network.
RCON_ALLOW_PRIVATE_HOSTS=
# apps/api — RCON connection tests per session per minute (default 5).
RATE_LIMIT_RCON_TEST=
# apps/api — client IP for every rate limit and audit row: `true` trusts CF-Connecting-IP (production
# behind Cloudflare; the origin must be reachable ONLY through Cloudflare, or anyone can forge it).
# Otherwise the last X-Forwarded-For hop (Traefik), else the socket peer. Runbook: docs/runbooks/deploy.md §5.
TRUST_CF_CONNECTING_IP=
