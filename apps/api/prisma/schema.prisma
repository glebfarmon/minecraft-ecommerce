generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  pl
}

enum Currency {
  EUR
  PLN
}

enum ProductKind {
  PERMANENT
  TIMED
  CASE
}

enum ProductIcon {
  crown
  box
  coins
  swords
  pickaxe
  ticket
}

model Server {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  accent          String
  onAccent        String
  rconHost        String?
  rconPort        Int?
  rconPasswordEnc String?
  isActive        Boolean          @default(true)
  sort            Int              @default(0)
  categories      ServerCategory[]
  products        Product[]

  @@map("servers")
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  translations CategoryTranslation[]
  servers      ServerCategory[]
  products     Product[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId String
  locale     Locale
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model ServerCategory {
  serverId   String
  categoryId String
  sort       Int
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([serverId, categoryId])
  @@index([categoryId])
  @@map("server_categories")
}

model Product {
  id             String               @id @default(cuid())
  serverId       String
  categoryId     String
  slug           String
  kind           ProductKind
  durationDays   Int?
  mark           String
  icon           ProductIcon
  grantCommands  String[]
  revokeCommands String[]
  isActive       Boolean              @default(true)
  sort           Int                  @default(0)
  server         Server               @relation(fields: [serverId], references: [id], onDelete: Restrict)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations   ProductTranslation[]
  prices         Price[]

  @@unique([serverId, slug])
  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  productId   String
  locale      Locale
  name        String
  description String
  sections    Json
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translations")
}

model Price {
  productId   String
  currency    Currency
  amountMinor Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, currency])
  @@map("prices")
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  twoFactorEnabled Boolean     @default(false)
  roleId           String?
  disabledAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  role             Role?       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  invitesSent      Invite[]    @relation("InviteSender")
  auditLogs        AuditLog[]

  @@map("user")
}

model Session {
  id                  String    @id
  expiresAt           DateTime
  token               String    @unique
  ipAddress           String?
  userAgent           String?
  userId              String
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  verified    Boolean @default(true)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("twoFactor")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  invites     Invite[]

  @@map("roles")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  roleId      String
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
