generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  pl
}

enum Currency {
  EUR
  PLN
}

enum ProductKind {
  PERMANENT
  TIMED
  CASE
}

enum ProductIcon {
  crown
  box
  coins
  swords
  pickaxe
  ticket
}

model Server {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  accent          String
  onAccent        String
  rconHost        String?
  rconPort        Int?
  rconPasswordEnc String?
  isActive        Boolean          @default(true)
  sort            Int              @default(0)
  version         Int              @default(1)
  categories      ServerCategory[]
  products        Product[]
  orderItems      OrderItem[]
  deliveries      Delivery[]
  grants          Grant[]

  @@map("servers")
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  icon         ProductIcon           @default(crown)
  version      Int                   @default(1)
  translations CategoryTranslation[]
  servers      ServerCategory[]
  products     Product[]
  promoCodes   PromoCodeCategory[]

  @@map("categories")
}

model CategoryTranslation {
  categoryId String
  locale     Locale
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
  @@map("category_translations")
}

model ServerCategory {
  serverId   String
  categoryId String
  sort       Int
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([serverId, categoryId])
  @@index([categoryId])
  @@map("server_categories")
}

model Product {
  id             String               @id @default(cuid())
  serverId       String
  categoryId     String
  slug           String
  kind           ProductKind
  durationDays   Int?
  mark           String
  /// Deprecated: unused since 2026-10-21 (the icon lives on Category); drop in the next release. Never read or write it.
  icon           ProductIcon?         @default(crown)
  grantCommands  String[]
  revokeCommands String[]
  isActive       Boolean              @default(true)
  sort           Int                  @default(0)
  version        Int                  @default(1)
  server         Server               @relation(fields: [serverId], references: [id], onDelete: Restrict)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations   ProductTranslation[]
  prices         Price[]
  orderItems     OrderItem[]
  promoCodes     PromoCodeProduct[]
  grants         Grant[]

  @@unique([serverId, slug])
  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  productId   String
  locale      Locale
  name        String
  description String
  sections    Json
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translations")
}

model Price {
  productId   String
  currency    Currency
  amountMinor Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, currency])
  @@map("prices")
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  twoFactorEnabled Boolean     @default(false)
  roleId           String?
  disabledAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  role             Role?       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  invitesSent      Invite[]    @relation("InviteSender")
  auditLogs        AuditLog[]

  @@map("user")
}

model Session {
  id                  String    @id
  expiresAt           DateTime
  token               String    @unique
  ipAddress           String?
  userAgent           String?
  userId              String
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  invites     Invite[]

  @@map("roles")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  roleId      String
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("invites")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  // Action prefix filter (LIKE 'x%'). The migration creates it with the text_pattern_ops operator
  // class (needed for prefix LIKE under non-C collations). Prisma's `ops: raw(...)` is not read back
  // from the database, so it would report drift; the plain declaration here matches without it.
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RulesDraft {
  id        Int      @id @default(1)
  content   Json
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
  updatedBy String

  @@map("rules_drafts")
}

model RulesVersion {
  id          Int      @id @default(autoincrement())
  content     Json
  publishedAt DateTime @default(now())
  publishedBy String

  @@index([publishedAt])
  @@map("rules_versions")
}

model MessageOverride {
  locale    Locale
  key       String
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String

  @@id([locale, key])
  @@map("message_overrides")
}

model SiteSettings {
  id             Int      @id @default(1)
  siteNamePlain  String
  siteNameAccent String
  serverIp       String
  discordUrl     String
  supportEmail   String
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt
  updatedBy      String

  @@map("site_settings")
}

enum OrderStatus {
  PENDING
  PAID
  DELIVERED
  EXPIRED
  REFUNDED
  DISPUTED
}

model Order {
  id                String      @id @default(cuid())
  publicId          String      @unique
  nick              String
  email             String
  locale            Locale
  currency          Currency
  subtotalMinor     Int
  discountMinor     Int         @default(0)
  totalMinor        Int
  status            OrderStatus @default(PENDING)
  stripeSessionId   String?     @unique
  /// Set by the paid webhook; the admin links the payment in the Stripe dashboard with it.
  stripePaymentIntentId String?
  deliveryConsentAt DateTime
  paidAt            DateTime?
  eurPlnRate        Decimal?    @db.Decimal(10, 4)
  rateDate          DateTime?   @db.Date
  totalEurMinor     Int?
  totalPlnMinor     Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  promoCodeId       String?
  /// The code text as typed at checkout; kept even if the promo is later soft-deleted.
  promoCode         String?
  promo             PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  items             OrderItem[]

  @@index([email])
  @@index([promoCodeId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  serverId        String
  quantity        Int
  unitAmountMinor Int
  productName     String
  serverName      String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  server          Server  @relation(fields: [serverId], references: [id], onDelete: Restrict)
  deliveries      Delivery[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ProcessedWebhookEvent {
  stripeEventId String   @id
  type          String
  createdAt     DateTime @default(now())

  @@map("processed_webhook_events")
}

enum PromoKind {
  PERCENT
  FIXED
}

/// Unique `code` among live rows is a partial unique index (promo_codes_code_live_key, WHERE "deletedAt" IS NULL) that lives in SQL: Prisma 7 partial indexes are still a preview feature.
model PromoCode {
  id         String              @id @default(cuid())
  code       String
  kind       PromoKind
  value      Int
  currency   Currency?
  maxUses    Int?
  usedCount  Int                 @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean             @default(true)
  deletedAt  DateTime?
  version    Int                 @default(1)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  categories PromoCodeCategory[]
  products   PromoCodeProduct[]
  orders     Order[]

  @@map("promo_codes")
}

model PromoCodeCategory {
  promoCodeId String
  categoryId  String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([promoCodeId, categoryId])
  @@index([categoryId])
  @@map("promo_code_categories")
}

model PromoCodeProduct {
  promoCodeId String
  productId   String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promoCodeId, productId])
  @@index([productId])
  @@map("promo_code_products")
}

enum DeliveryKind {
  GRANT
  REVOKE
}

enum DeliveryStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  NEEDS_REVIEW
}

model Delivery {
  id            String         @id @default(cuid())
  orderItemId   String?
  grantId       String?
  serverId      String
  kind          DeliveryKind
  commands      String[]
  commandsDone  Int            @default(0)
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  startedAt     DateTime?
  lastError     String?
  responseLog   Json           @default("[]")
  alertedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  grant         Grant?         @relation(fields: [grantId], references: [id], onDelete: Cascade)
  server        Server         @relation(fields: [serverId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([grantId])
  @@index([serverId])
  @@map("deliveries")
}

model Grant {
  id         String     @id @default(cuid())
  nick       String
  serverId   String
  productId  String
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  server     Server     @relation(fields: [serverId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([nick, serverId, productId])
  @@index([serverId])
  @@index([productId])
  @@map("grants")
}
