                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "entityId": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "before": {},
                          "after": {},
