{
  "name": "@shop/shared",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./dist/orders.js"
    },
    "./catalog-admin": {
      "types": "./dist/catalog-admin.d.ts",
      "default": "./dist/catalog-admin.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./validation-messages": {
      "types": "./dist/validation-messages.d.ts",
      "default": "./dist/validation-messages.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
